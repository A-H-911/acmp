<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <!-- ⚠ One decision in four places — see the note in Acmp.Modules.Integrations.Webex.csproj.
         Hangfire.SqlServer pins Hangfire.Core EXACTLY, so all four move together or restore fails NU1107. -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Docker-secrets config source (/run/secrets -> config keys, ADR-0032). First-party. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <!-- NFR-043 / DW-062: the requirement names four span kinds per inbound request. AspNetCore covers the
         handler; these two cover the DB query and the outbound HTTP call. SqlClient (not the EF Core
         instrumentation) because it spans the command actually sent to SQL Server, which is what a latency
         question asks about. There is deliberately NO OpenTelemetry.Instrumentation.Hangfire here: it has
         never shipped a stable release (latest is 1.17.0-beta.1), and a prerelease dependency in a
         production image is the operator's call, not this change's. Job DISPATCH — the half NFR-043 actually
         names — is spanned in-process instead; see AcmpTelemetry. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Membership\Membership.Infrastructure\Acmp.Modules.Membership.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Topics\Topics.Infrastructure\Acmp.Modules.Topics.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Meetings\Meetings.Infrastructure\Acmp.Modules.Meetings.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Decisions\Decisions.Infrastructure\Acmp.Modules.Decisions.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Actions\Actions.Infrastructure\Acmp.Modules.Actions.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Notifications.Infrastructure\Acmp.Modules.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Acmp.Shared\Acmp.Shared.csproj" />
    <ProjectReference Include="..\Modules\Risks\Risks.Infrastructure\Acmp.Modules.Risks.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Traceability\Traceability.Infrastructure\Acmp.Modules.Traceability.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Dependencies\Dependencies.Infrastructure\Acmp.Modules.Dependencies.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Governance\Governance.Application\Acmp.Modules.Governance.Application.csproj" />
    <ProjectReference Include="..\Modules\Governance\Governance.Infrastructure\Acmp.Modules.Governance.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Research\Research.Application\Acmp.Modules.Research.Application.csproj" />
    <ProjectReference Include="..\Modules\Research\Research.Infrastructure\Acmp.Modules.Research.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Knowledge\Knowledge.Application\Acmp.Modules.Knowledge.Application.csproj" />
    <ProjectReference Include="..\Modules\Knowledge\Knowledge.Infrastructure\Acmp.Modules.Knowledge.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Integrations\Webex\Acmp.Modules.Integrations.Webex.csproj" />
    <!-- Shared composition root (ADR-0024): AddAcmpModules / AddAcmpHangfireStorage, shared with Acmp.Worker. -->
    <ProjectReference Include="..\Acmp.Bootstrap\Acmp.Bootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DEF-078: ObjectStoreHealthCheck is internal but must be unit-assertable. Exposing internals to the test
      project is preferred over making the type public - the readiness checks are composition detail, not API
      surface, and widening them to be testable would be letting the test dictate the design.
    -->
    <InternalsVisibleTo Include="Acmp.Api.Tests" />
  </ItemGroup>

</Project>
