# CLOUD-ONLY 443 listener (SL-025 / AC-081). NOT baked into the image: docker-compose.cloud.yml
# bind-mounts this file into /etc/nginx/templates/ so only the cloud stack gets it. On-prem, dev and
# e2e have no certificates, and a 443 server block whose ssl_certificate does not exist stops nginx
# from starting at all — so shipping this in the image would break every non-cloud topology.
#
# The default.conf 8080 server stays alongside this one. It is what the container healthcheck probes
# and, because 01-network.sh opens 443 INBOUND ONLY, port 80/8080 is unreachable from the internet —
# there is deliberately no http->https redirect here, since there is no http to redirect.
#
# CERT PATHS ARE FIXED, not templated. One host per environment means a literal path works, and it
# keeps NGINX_ENVSUBST_FILTER unchanged — a variable used here but missing from that filter is not
# left alone, nginx reads the surviving ${NAME} as one of its own and dies with `unknown "NAME"
# variable`. Fewer moving parts, and no image rebuild to add a listener.
#
# certbot never writes here directly: deploy/scripts/certbot-deploy-hook.sh dereferences Let's
# Encrypt's symlinks and copies with ownership this container (UID 101) can actually read. The
# bootstrap drops a self-signed placeholder first so nginx can start BEFORE a certificate exists —
# without it, first boot deadlocks (no cert -> no nginx -> no stack -> nobody to run certbot).
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # TLS 1.2 + 1.3 only. 1.0/1.1 are deprecated by RFC 8996 and would fail the AC-081 posture check.
    ssl_protocols TLSv1.2 TLSv1.3;
    # Let the CLIENT choose among our offered suites: modern clients pick AEAD suites correctly and
    # server-preferred ordering mainly freezes yesterday's ranking into the config.
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # 10m of shared cache is ~40k sessions and sits inside the container's 64 MiB limit. Tickets off:
    # without key rotation they undermine forward secrecy, and a <=20-user committee gains nothing.
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No OCSP stapling on purpose: Let's Encrypt has retired its OCSP responders, so stapling has
    # nothing to staple and would only add a failure mode and a startup warning.

    # SECURITY HEADERS — REPEATED IN FULL, DELIBERATELY.
    # nginx's add_header does not merge across levels: these cannot be inherited from the 8080 server
    # block, and a single add_header inside any location below would drop every one of them. If you
    # add a header to one server block, add it to the other. Keep this list identical to
    # default.conf.template — the two blocks serve the same app and must not have different postures.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS (C-WEB-01, AC-081). Unlike the 8080 block this one is actually reached over https, so this
    # is the header that counts. 1 year + includeSubDomains, still no `preload` — that is an
    # irreversible public-list commitment and remains the operator's call, not the image's.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' ${ACMP_MEDIA_ORIGIN}; connect-src 'self' ${KEYCLOAK_ORIGIN}; frame-src ${KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    # Keycloak's admin console and master realm are NOT part of this application's surface (SL-025).
    # Everything under /kc/ is publicly reachable the moment 443 exists, and that would put the
    # realm-administration UI and the master realm's endpoints on the public internet next to the
    # login page. The SPA only ever needs /kc/realms/acmp/... plus /kc/resources/..., so denying
    # these costs the product nothing. Administration goes through SSM to the box, not the internet.
    #
    # A regex location wins over the /kc/ prefix location below regardless of order. 404 rather than
    # 403 so the response does not confirm that an admin console is there at all.
    location ~ ^/kc/(admin|realms/master)(/|$) {
        return 404;
    }

    # /kc/ IS NOT OUR APPLICATION SURFACE, and it must not inherit the SPA's headers (DEF-023's second
    # finding, assessed on the rebuilt box). The server-level add_headers above apply to everything
    # proxied here, and two of them are actively wrong for Keycloak's own pages:
    #
    #   * script-src 'self' blocks the login theme's INLINE scripts — 7 CSP violations were observed
    #     in the console on every login. The form still submits, so it is not fatal today, but the
    #     theme is running degraded and anything script-driven (password-strength hints, the locale
    #     switcher, WebAuthn) is one Keycloak release away from breaking with no error we would see.
    #   * X-Frame-Options: DENY is emitted ON TOP of Keycloak's own SAMEORIGIN, and conflicting XFO
    #     headers resolve to deny. The SPA sets automaticSilentRenew with no silent_redirect_uri, so
    #     oidc-client-ts renews through a hidden same-origin iframe pointed HERE — which DENY blocks.
    #     The symptom is not an error, it is users being logged out at token expiry instead of renewed.
    #
    # So Keycloak owns the two headers that describe ITS pages: it already sets X-Frame-Options
    # SAMEORIGIN (which permits the same-origin renew iframe and nothing else), Referrer-Policy
    # no-referrer, X-Content-Type-Options nosniff, and its own CSP. We keep only the two it does not
    # set and that are transport-level rather than content-level.
    #
    # REMINDER, because it is the trap this file warns about at the top: add_header does not merge
    # across levels, so THIS BLOCK'S add_headers replace the server-level set entirely for /kc/.
    # Anything you want here must be listed here.
    location /kc/ {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

        proxy_pass http://keycloak:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    # Kept for parity with the 8080 block. In the cloud topology there is no minio container
    # (ADR-0035) and this location is never taken — recordings are presigned straight to S3 — but the
    # variable upstream means nginx still loads the config instead of refusing to start on an
    # unresolvable name.
    location /acmp-recordings/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $recordings_upstream "minio:9000";
        proxy_pass http://$recordings_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        chunked_transfer_encoding off;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same large-upload allowances as the 8080 block (FR-056): 2 GiB recordings, long timeouts,
        # and request buffering off because /tmp is a 64m tmpfs on a read-only root filesystem.
        client_max_body_size 2100m;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
