server {
    # 8080 (not 80): the runtime image is nginx-unprivileged (non-root UID 101, C-CON-001) which cannot
    # bind privileged ports. Compose maps host 8088 -> 8080; the healthcheck probes 8080.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # DEF-152: the SPA shipped UNCOMPRESSED in BOTH environments. Measured 2026-09-09: the 1.1 MB
    # bundle returned no Content-Encoding under `Accept-Encoding: gzip, deflate, br`, and identical
    # bytes under `identity`, so the server was not compressing rather than the client refusing. The
    # same bytes are 3.69x smaller under gzip -9 (1,158,274 -> 313,737), and that was the proximate
    # cause of a 13.7 s cold page load against NFR-001's 2,000 ms bound.
    #
    # gzip ONLY. The runtime image is nginxinc/nginx-unprivileged:1.31-alpine, which ships NO brotli
    # module. Adding `brotli on` here does not degrade gracefully - nginx refuses to start on an
    # unknown directive, so the mistake takes the whole stack down. Change the base image first.
    #
    # text/html is compressed implicitly by nginx and must NOT be repeated in gzip_types.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/manifest+json image/svg+xml font/ttf font/otf;
    index index.html;

    # Security headers (docs/domain/security-controls.md). script-src 'self' only (OQ-028); Vite emits no inline scripts.
    # connect-src + frame-src allow the self-hosted Keycloak origin (ADR-0015) so the SPA can fetch
    # OIDC metadata/token/JWKS and run the silent-renew iframe. ${KEYCLOAK_ORIGIN} is substituted at
    # container start (nginx envsubst); each environment supplies its own origin with no rebuild.
    #
    # These are declared at SERVER level so nginx inherits them into every location (/api/, /kc/,
    # /acmp-recordings/). Do NOT add an `add_header` inside a location block: nginx's add_header does not
    # merge across levels — a single one in a location DROPS every header inherited from here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS (C-WEB-01). Honored only over https (the ngrok/edge-TLS path) and ignored by browsers over plain
    # http, so the http dev profile is unaffected. 1 year + includeSubDomains meets ASVS L2; no `preload`
    # — that is an irreversible public-list commitment and is the operator's call, not the image's (P18).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Permissions-Policy (C-WEB-01): ACMP uses none of these powerful features — recordings are uploaded as
    # files (FR-056), never captured in-browser — so deny them outright rather than leaving them available
    # to any injected or third-party frame.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # style-src 'self' with NO 'unsafe-inline' (C-WEB-02 / OQ-028). This needs no frontend refactor: CSP
    # governs `<style>` elements and `style=""` attributes, NOT the CSSOM — and react-dom applies the
    # style={{}} prop via CSSOM writes (`style.setProperty(...)` / `style[name] = v`), never by serializing
    # a style attribute. There is no SSR here (client-rendered Vite SPA) so no style attribute is ever
    # emitted, index.html carries none, and MarkdownView's DOMPurify allowlist excludes both `style` attrs
    # and `<style>` tags. Verified live: zero CSP violations (see docs/progress/progress-log.md, P16-B3).
    # media-src: recording playback is a <video src> pointing at a presigned object URL. On-prem that URL is
    # same-origin (proxied to MinIO below) so 'self' covers it and ${ACMP_MEDIA_ORIGIN} is empty. In cloud the
    # URL is presigned straight to S3 (ADR-0035) and default-src 'self' would BLOCK it, so each environment
    # supplies its object-store origin, which must equal the host the SDK actually SIGNS for. Since the
    # Minio 6.0.3 -> 6.0.5 upgrade (DEF-021) that IS the configured endpoint; 6.0.3 rewrote any Amazon host
    # via AWSS3Endpoints (us-east-1 -> the legacy global s3.amazonaws.com), so the two used to disagree and
    # ACMP_MEDIA_ORIGIN changed with the upgrade. Pinned by MinioFileStoreCloudTests offline and confirmed
    # live by MinioFileStoreLiveS3Tests, so this header cannot drift from what is signed.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' ${ACMP_MEDIA_ORIGIN}; connect-src 'self' ${KEYCLOAK_ORIGIN}; frame-src ${KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    # Keycloak served same-origin over https under /kc (PR-C, ngrok-only): the SPA (https) reaches its IdP
    # without mixed content. The trailing slash on proxy_pass strips /kc so KC (served at root) matches;
    # X-Forwarded-* (with KC_PROXY_HEADERS=xforwarded) make KC emit https absolute URLs (issuer = /kc).
    # KEPT IDENTICAL TO cloud-443.conf.template (DEF-023's second finding) — see the long note there.
    # Keycloak's own pages must not inherit the SPA's CSP or X-Frame-Options: script-src 'self' blocks
    # the login theme's inline scripts, and our DENY lands on top of Keycloak's SAMEORIGIN (conflicting
    # XFO resolves to deny), which blocks the same-origin iframe automaticSilentRenew uses — dropping
    # sessions at token expiry with no error. Keycloak already sets XFO, Referrer-Policy, nosniff and
    # its own CSP for these pages. add_header does not merge, so this block replaces the server-level
    # set for /kc/ entirely: whatever belongs here must be listed here.
    location /kc/ {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

        proxy_pass http://keycloak:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    # Presigned MinIO object GETs for recording playback (ADR-0014, P13). Only presigned requests validate —
    # MinIO 403s anything unsigned and never lists the bucket. No trailing slash on proxy_pass so the
    # /acmp-recordings/<object> path (the S3 bucket path) is preserved; Host is forwarded so the SigV4
    # signature validates against the host the app signed. chunked/buffering off per MinIO-behind-proxy guidance.
    #
    # The upstream is held in a VARIABLE on purpose. With a literal name nginx resolves it while LOADING the
    # config and refuses to start when it does not exist — which is exactly the cloud stack (ADR-0035): no
    # minio container, recordings presigned straight to S3, so this location is never taken there. A variable
    # defers resolution to request time (hence the resolver — Docker's embedded DNS), leaving one image that
    # boots in both topologies instead of two nginx templates to keep in step.
    location /acmp-recordings/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $recordings_upstream "minio:9000";
        proxy_pass http://$recordings_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        chunked_transfer_encoding off;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Meeting recordings are large video (FR-056). Default 1m would 413 any real upload; allow up to the
        # app's recording cap. Give slow large uploads room before the proxy times out.
        client_max_body_size 2100m;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Stream the request body straight to Kestrel instead of spooling it to client_body_temp first
        # (C-CON-003). The root FS is now read-only and /tmp — where this image puts client_body_temp — is a
        # 64m tmpfs, so buffering a 2 GiB recording would both fail and burn RAM. Off = nginx forwards as it
        # reads. NOTE: this only stops the PROXY buffering; ASP.NET still spools the multipart section to the
        # api's own /tmp, which is why that one is a disk volume (see docker-compose.yml).
        proxy_request_buffering off;
    }

    # DEF-152: Vite emits content-hashed filenames (index-<hash>.js), so a year is safe by
    # construction - a changed asset arrives under a NEW name rather than as new bytes at the old one.
    #
    # `expires`, NOT `add_header Cache-Control`. The warning at the top of this file is load-bearing
    # here: add_header does not merge across levels, so a SINGLE add_header in this location would
    # silently drop every server-level security header - nosniff, X-Frame-Options, Referrer-Policy,
    # HSTS, CSP - for every asset the SPA loads. `expires` emits Cache-Control without touching
    # add_header inheritance, which is why it is used instead.
    location /assets/ {
        expires 1y;
        access_log off;
        # A missing asset must 404. Falling through to `location /`'s try_files would return
        # index.html - HTML served with a JavaScript content-type, which fails confusingly.
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
