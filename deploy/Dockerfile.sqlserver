# ACMP SQL Server image = stock SQL Server 2025 + Full-Text Search (FR-143/145, AC-061).
# The stock mcr.microsoft.com/mssql/server:2025-latest ships WITHOUT Full-Text Search
# (SERVERPROPERTY('IsFullTextInstalled') = 0); global search needs it, so we install the
# mssql-server-fts package from the Ubuntu 24.04 Microsoft repo. The Arabic word-breaker
# (LCID 1025) rides in with it (OQ-034 spike, ph0-validation §7).
#
# Base digest-pinned (C-SUP-01, P16b/B2b) — tag kept before @sha256: for Dependabot.
#
# ⚠⚠ THE `FROM` BELOW AND THE PACKAGE-REPO URL IN THE RUN BLOCK ARE ONE DECISION IN TWO
# PLACES, AND THEY MUST MOVE TOGETHER. The repo path encodes BOTH the Ubuntu release and the
# SQL Server major: ubuntu/<release>/mssql-server-<major>. Dependabot bumps only the FROM line
# and cannot see the coupling, so its bump PR can never go green on its own — which is exactly
# how #135 failed. mssql-server-fts pulls in mssql-server itself, so with the old repo an
# Ubuntu-22.04 mssql-server was installed OVER a 24.04 base, leaving a sqlservr linked against
# liblber-2.5.so.0 that 24.04 does not ship (OpenLDAP renamed the soname). NEITHER BASE IMAGE
# WAS BROKEN — ldd reports nothing missing in either. See DW-078 / PE-606.
FROM mcr.microsoft.com/mssql/server:2025-latest@sha256:4bab24f36c1ecd48e85f7d37df26e6bf301641d84c3fe652f9a0dcc947d512e1
USER root
# --no-install-recommends keeps the layer minimal (C-CON-002 / DS-0029) — no suggested extras.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg2 \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/microsoft.gpg \
 && curl -fsSL https://packages.microsoft.com/config/ubuntu/24.04/mssql-server-2025.list -o /etc/apt/sources.list.d/mssql-server-2025.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends mssql-server-fts \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
USER mssql
# Docker-secrets shim (ADR-0032): if MSSQL_SA_PASSWORD_FILE is set, load the SA password from it; no-op otherwise
# (Testcontainers/dev pass the plain MSSQL_SA_PASSWORD env). INLINED, not a COPYed script, on purpose: this
# Dockerfile is built with TWO contexts — compose uses the repo root, SearchProvidersFtsTests uses deploy/ — so a
# COPY path cannot resolve in both. `exec` keeps sqlservr as PID 1 with signals intact.
ENTRYPOINT ["/bin/sh", "-c", "if [ -n \"${MSSQL_SA_PASSWORD_FILE:-}\" ] && [ -f \"$MSSQL_SA_PASSWORD_FILE\" ]; then MSSQL_SA_PASSWORD=\"$(cat \"$MSSQL_SA_PASSWORD_FILE\")\"; export MSSQL_SA_PASSWORD; fi; exec /opt/mssql/bin/sqlservr"]
