# ACMP CLOUD environment template (PH-5 / SL-021). Copy to deploy/.env ON THE INSTANCE and
# fill in. deploy/.env is git-ignored — never commit real values (INV-007).
#
#   cp deploy/.env.cloud.example deploy/.env && $EDITOR deploy/.env
#   sh deploy/scripts/gen-secrets.sh
#   docker compose -f deploy/docker-compose.cloud.yml --env-file deploy/.env up -d
#
# EVERY value below differs between UAT and production. Getting one wrong breaks login or
# leaks UAT traffic into the committee's real Webex space.

# --- environment identity ---------------------------------------------------------------
# UAT  -> uat.acmp.anas7ammo.dev      PROD -> acmp.anas7ammo.dev
ACMP_ENV=uat
ACMP_HOST=uat.acmp.anas7ammo.dev

# --- images (ECR, pushed by CI in slice P24) ----------------------------------------------
# Never build on the box: npm ci + dotnet publish need ~2 GiB each and will OOM a 4 GiB host.
ACMP_REGISTRY=565393059398.dkr.ecr.us-east-1.amazonaws.com/acmp
# Covers api, worker and sqlserver-fts, which are environment-AGNOSTIC and published as a plain
# commit SHA — the same bytes are promoted from UAT to production.
ACMP_IMAGE_TAG=latest
# web is NOT environment-agnostic and needs its own tag (DEF-019). ADR-0037 bakes the OIDC
# authority into the bundle at build time, so CI publishes web:<sha>-uat and web:<sha>-prod and
# there is NO plain web:<sha> to pull — the registry answers ImageNotFoundException for it. Set
# this to the SHA plus this box's environment suffix, and never point production at a -uat image.
ACMP_WEB_TAG=latest
AWS_REGION=us-east-1

# --- Keycloak (ADR-0036: persists to SQL Server; ADR-0037: same-origin under /kc) ----------
# All three MUST stay consistent; KEYCLOAK_AUTHORITY must equal the SPA's VITE_OIDC_AUTHORITY
# byte-for-byte (it is baked into the web image at build time).
KEYCLOAK_HOSTNAME=https://uat.acmp.anas7ammo.dev/kc
KEYCLOAK_AUTHORITY=https://uat.acmp.anas7ammo.dev/kc/realms/acmp
# Also the SPA's own origin (same origin, /kc/ prefix). keycloak-config reconciles acmp-web's
# redirectUris/webOrigins from it on every `up` — DEF-023: the committed realm knows only the dev
# hostnames, so if this is wrong Keycloak refuses the login redirect and the box is unusable while
# every health check stays green.
KEYCLOAK_ORIGIN=https://uat.acmp.anas7ammo.dev
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Keycloak's SQL Server login (sqlserver-init creates it; gen-secrets writes the secret).
ACMP_KC_DB_NAME=keycloak
ACMP_KC_DB_USER=keycloak_svc
ACMP_KC_DB_PASSWORD=CHANGE_ME

# --- SQL Server ---------------------------------------------------------------------------
MSSQL_SA_PASSWORD=CHANGE_ME
ACMP_DB_NAME=Acmp
# Least-priv runtime login (ADR-0031). Leave as acmp_svc — 'sa' would bypass the audit DENY.
ACMP_DB_USER=acmp_svc
ACMP_DB_PASSWORD=CHANGE_ME
ACMP_DB_TRUSTCERT=True
ACMP_BACKUP_DIR=/opt/acmp/backups
# Off-instance backup copy (NFR-058), written by deploy/scripts/backup.sh via the INSTANCE PROFILE — no key
# here. Created by deploy/aws/02-s3.sh, which also expires objects on the same clock as the local prune.
# Unset => local-only backups, which is not a backup.
ACMP_BACKUP_BUCKET=acmp-uat-backups
BACKUP_RETENTION_DAYS=30
# Where backup.sh publishes a FAILURE (DEF-031's open gap). Unset => a failed nightly backup is visible
# only in /var/log/acmp-backup.log, i.e. to nobody, which is the failure mode AC-080's unattended regime
# exists to prevent. Reuses the budget-alerts topic on purpose: it already carries the operator's
# CONFIRMED email subscription, so this needs no new topic and no second confirmation click. The name is
# admittedly narrower than its use — if a second channel is ever wanted, create acmp-ops-alerts and point
# this at it. Requires sns:Publish on the instance role (deploy/aws/03-iam.sh, SnsPublishFailureAlerts).
ACMP_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:565393059398:acmp-budget-alerts
# How stale the newest off-instance backup may be before check-backup-freshness.sh reports it
# (OQ-068 option (e) — detects the ABSENCE of backups, which failure alerting cannot see). ~26h suits
# an always-on box. UAT is deliberately STOPPED for days at a time, so a 26h threshold here would
# report staleness on almost every boot and train the operator to ignore it — the same trap OQ-067
# describes. 168h (7 days) reports a genuinely neglected environment without crying wolf.
ACMP_BACKUP_MAX_AGE_HOURS=168
# Both stateful databases. Restoring Acmp alone leaves a system nobody can log into (AC-080 checks both).
ACMP_DB_NAMES="Acmp keycloak"

# --- S3 object storage (ADR-0035; keys emitted by deploy/aws/03-iam.sh) -------------------
# ONE bucket per environment holds recordings AND topic attachments (deploy/aws/02-s3.sh).
ACMP_S3_ENDPOINT=s3.us-east-1.amazonaws.com
ACMP_S3_BUCKET=acmp-uat-recordings
ACMP_S3_ACCESS_KEY=CHANGE_ME
ACMP_S3_SECRET_KEY=CHANGE_ME
# CSP media-src origin for <video> playback of a presigned recording. Must match the origin the SDK
# actually SIGNS for, or the browser blocks playback with nothing in the API logs.
#
# CHANGED when the Minio SDK was upgraded 6.0.3 -> 6.0.5 (DEF-021). 6.0.3 recognised any Amazon host
# and replaced it from its own region map (AWSS3Endpoints), rewriting us-east-1 to the LEGACY GLOBAL
# "s3.amazonaws.com" whatever endpoint was configured — so this value deliberately disagreed with
# ACMP_S3_ENDPOINT. 6.0.5 honours the configured endpoint, so the two now agree and the presigned URL
# is https://s3.<region>.amazonaws.com/<bucket>/<key>. Verified against the live service, not assumed.
# Still pinned by tests/Acmp.Integration.Tests/MinioFileStoreCloudTests.cs — if that test changes,
# change this; and re-read it before trusting this value on any other region.
ACMP_MEDIA_ORIGIN=https://s3.us-east-1.amazonaws.com

# --- observability ------------------------------------------------------------------------
# Seq runs in BOTH environments (CON-001 self-hosted observability). Generate the hash with:
#   docker run --rm datalust/seq config hash
SEQ_FIRSTRUN_ADMINPASSWORDHASH=CHANGE_ME

# --- ports / TLS ---------------------------------------------------------------------------
ACMP_HTTP_PORT=80
ACMP_HTTPS_PORT=443
ACMP_REQUIRE_HTTPS_METADATA=true

# --- In-app user management (ADR-0038 / FR-156, FR-157) --------------------------------------
# OFF until the operator switches it on. Enabling is a ONE-VARIABLE change: the secret below is
# always written by gen-secrets and keycloak-config reconciles the client + its minimum grant on
# every boot, so there is no ordering dance. ⚠ KeycloakAdminOptions is ValidateOnStart — setting
# Enabled=true while ClientSecret is still CHANGE_ME STOPS api AND worker at boot, by design.
KEYCLOAK_ADMIN_ENABLED=false
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# BaseUrl stays the IN-CLUSTER address. The admin API is deliberately unreachable through the
# public listener (AC-081), so this must NOT be the https hostname.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080/
# Client id + the minimum grant: deploy/keycloak/admin-client.env. The grant is `manage-users`
# and nothing else, PROVEN on this very box 2026-08-12 (OQ-070). realm-admin is forbidden.

# --- Webex (OQ-062: OFF in UAT until a dedicated UAT space + bot exist) --------------------
# NEVER point UAT at the production Webex space.
WEBEX_ENABLED=false
#WEBEX_SPACE_ID=
#WEBEX_WEBHOOK_PUBLIC_URL=https://uat.acmp.anas7ammo.dev/api/webex/webhook
#WEBEX_ACMP_BASE_URL=https://uat.acmp.anas7ammo.dev
#WEBEX_OAUTH_CLIENT_ID=
#WEBEX_OAUTH_REDIRECT_URI=https://uat.acmp.anas7ammo.dev/api/webex/oauth/callback
#WEBEX_BOT_TOKEN=
#WEBEX_WEBHOOK_SECRET=
#WEBEX_OAUTH_CLIENT_SECRET=
#WEBEX_TOKEN_ENCRYPTION_KEY=
#WEBEX_OAUTH_SETUP_KEY=

# Hangfire action-reminder sweep (default daily 06:00). MUST be quoted: gen-secrets.sh
# SOURCES this file, so an unquoted cron expression is parsed as a command + arguments.
ACTION_REMINDERS_SWEEP_CRON="0 6 * * *"
