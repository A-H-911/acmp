# syntax=docker/dockerfile:1.7-labs
# Shared build for the ASP.NET Core 10 API + the .NET 10 Worker (docs/domain/deployment.md, ADR-0024).
#
# ONE build stage for BOTH: the shared kernel + all modules compile ONCE, not twice. The previous separate
# Dockerfile.api / Dockerfile.worker each restored AND published the full dependency graph independently —
# double the restore + double the compile, run concurrently by `docker compose up --build`, which saturated
# (and on a constrained WSL2 host, crashed) the build daemon. BuildKit deduplicates this `build` stage across
# the api + worker targets, so `docker compose build api worker` runs it a single time.
#
# Restore-layer caching: only the .csproj files are copied before `dotnet restore` (via COPY --parents, which
# preserves each project's directory structure), so a SOURCE-only change reuses the cached restore layer and
# only re-publishes. The full source is copied afterwards.
#
# Base images are digest-pinned (C-SUP-01, P16b/B2b) — the tag is kept before @sha256: so Dependabot's docker
# ecosystem can bump the pair. Digests are multi-arch manifest-list digests (docker buildx imagetools).
# ⚠⚠ LL-019: THIS PIN AND `global.json` ARE ONE DECISION IN TWO PLACES, AND ONLY THIS ONE IS AUTOMATED.
# Dependabot bumps the digest here; nothing tells global.json. This image ships SDK 10.0.302, so
# global.json pins 10.0.302 with rollForward `latestFeature` — the roll-forward is what lets a developer
# machine on a HIGHER feature band (10.0.4xx) still build, while the container matches exactly.
# ⚠ DW-080 phase A pinned global.json to the LOCAL SDK (10.0.400) first, and the container was the thing
# that failed: "Requested SDK version: 10.0.400 / Installed SDKs: 10.0.302". `latestPatch` cannot cross a
# feature band. THE IMAGE IS THE AUTHORITY, NOT THE DEVELOPER'S BOX — if a digest bump changes the SDK
# band, global.json's floor moves with it.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS build
WORKDIR /src
COPY global.json acmp.sln ./
COPY --parents src/**/*.csproj ./
RUN dotnet restore src/Acmp.Api/Acmp.Api.csproj \
 && dotnet restore src/Acmp.Worker/Acmp.Worker.csproj \
 && dotnet restore src/Acmp.HealthProbe/Acmp.HealthProbe.csproj
COPY src/ ./src/
# Two publishes in one stage: the second reuses the first's already-compiled shared assemblies (incremental),
# so shared code is compiled once rather than once per image.
RUN dotnet publish src/Acmp.Api/Acmp.Api.csproj -c Release -o /app/api --no-restore \
 && dotnet publish src/Acmp.Worker/Acmp.Worker.csproj -c Release -o /app/worker --no-restore \
 && dotnet publish src/Acmp.HealthProbe/Acmp.HealthProbe.csproj -c Release -o /app/api --no-restore

# --- API runtime (HTTP; the healthcheck is a .NET probe, not curl) ---
# DW-080 phase B / DEC-090 d1 — the base is CHISELED-EXTRA, chosen against MEASURED findings rather than
# documentation: 162 MB against Debian's 229; medium CVEs 26 -> 4 and low 13 -> 7 with no highs, where BOTH
# alpine variants carry two; glibc, so the musl/native-interop risk around Microsoft.Data.SqlClient is gone.
#
# ⚠⚠ THE `-extra` SUFFIX IS LOAD-BEARING AND IS NOT AN OPTIMISATION TO STRIP. Plain chiseled ships NO ICU,
# and a .NET app on a no-ICU base does NOT fail at startup — it starts, exits 0, and silently enters
# globalization-invariant mode, throwing CultureNotFoundException only when a non-invariant culture is first
# TOUCHED. ACMP's API touches none today (all 10 CultureInfo uses are InvariantCulture; RequestLocalization,
# IStringLocalizer, .resx and new CultureInfo return zero across 693 .cs files), so the plain image would
# look perfectly healthy while arming a trap for the first server-side culture code anyone writes.
#
# ⚠ `-extra` IS ALSO NOT INTERCHANGEABLE WITH alpine-extra. That image ships ICU 78.1 against this one's
# 74.2, and CLDR changed ar-SA's default calendar in between: the same published binary renders a Hijri
# date here and a Gregorian one there, with no exception and no log line. THE ICU VERSION IS THE RISK, not
# musl — which is why a base bump that changes the ICU major needs the Arabic render checked, not just a
# green suite.
#
# ⚠ curl is gone because chiseled has no shell and no package manager. The compose healthcheck runs
# Acmp.HealthProbe.dll through the dotnet host instead, and it still probes /readyz rather than a socket,
# because DEF-079 was exactly a healthcheck that could only fail if the process stopped answering TCP.
# Runs as the image's built-in non-root `app` user (UID 1654, ships in the aspnet images) — C-CON-001 / DS-0002.
# Kestrel binds 8080 (unprivileged port), so no root/cap_net_bind is needed.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra@sha256:f5b3b2e2e548828d50e349726f51a5de001286f02c4bbde77db0dd34eb9f55ff AS api
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown
LABEL org.opencontainers.image.title="ACMP API" \
      org.opencontainers.image.source="https://github.com/A-H-911/acmp" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
WORKDIR /app
COPY --from=build /app/api ./
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "Acmp.Api.dll"]

# --- Worker runtime (headless; aspnet base, NOT runtime — the shared kernel's CurrentUserService pulls in
# IHttpContextAccessor / Microsoft.AspNetCore.App transitively, so the slim runtime image crashes at startup) ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra@sha256:f5b3b2e2e548828d50e349726f51a5de001286f02c4bbde77db0dd34eb9f55ff AS worker
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown
LABEL org.opencontainers.image.title="ACMP Worker" \
      org.opencontainers.image.source="https://github.com/A-H-911/acmp" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
WORKDIR /app
COPY --from=build /app/worker ./
ENV DOTNET_ENVIRONMENT=Production
USER app
ENTRYPOINT ["dotnet", "Acmp.Worker.dll"]
